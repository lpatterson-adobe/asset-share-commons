{
  "name": "aem-maven-archetype",
  "version": "1.0.0",
  "description": "Generates an AEM Frontend project with Webpack",
  "repository": {
    "type": "git",
    "url": "https://github.com/adobe/aem-project-archetype"
  },
  "private": true,
  "main": "src/index.js",
  "license": "SEE LICENSE IN LICENSE.txt",
  "scripts": {
    "dev": "webpack -d --env dev --config ./webpack.dev.js && clientlib --verbose",
    "preprod": "node ./scripts/sync-fomantic-theme-config.js",
    "prod": "webpack --config ./webpack.prod.js && clientlib --verbose",
    "start": "webpack-dev-server --open --config ./webpack.dev.js"
  },
  "devDependencies": {
    "aem-clientlib-generator": "^1.10.0",
    "autoprefixer": "^10.4.23",
    "browserslist": "^4.28.1",
    "clean-webpack-plugin": "^4.0.0",
    "copy-webpack-plugin": "^13.0.1",
    "css-loader": "^7.1.2",
    "css-minimizer-webpack-plugin": "^7.0.4",
    "cssnano": "^7.1.2",
    "file-loader": "^6.2.0",
    "html-webpack-plugin": "^5.6.6",
    "less": "^4.5.1",
    "less-loader": "^12.3.0",
    "mini-css-extract-plugin": "^2.10.0",
    "postcss-loader": "^8.2.0",
    "source-map-loader": "^5.0.0",
    "style-loader": "^4.0.0",
    "terser-webpack-plugin": "^5.3.16",
    "url-loader": "^4.1.1",
    "webpack": "^5.104.1",
    "webpack-cli": "^6.0.1",
    "webpack-dev-server": "^5.2.3",
    "webpack-import-glob-loader": "^1.6.3",
    "webpack-merge": "^6.0.1"
  },
  "dependencies": {
    "fomantic-ui-less": "^2.9.4",
    "jquery": "^4.0.0"
  },
  "browserslist": [
    "last 2 version",
    "> 1%"
  ]
